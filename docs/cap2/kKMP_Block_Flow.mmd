flowchart TD
    A["Tính bảng pi cho từng pattern"] --> B["Khởi tạo state[0..k-1] = 0"]
    B --> C["Đọc block kế tiếp"]
    C --> D{"Còn byte trong block?"}
    D -- "Có" --> E["Lấy byte c và giữ globalOffset"]
    E --> F["Với từng pattern i, cập nhật state[i]"]
    F --> G{"Không khớp và state[i] > 0?"}
    G -- "Có" --> H["state[i] = pi[i][state[i] - 1]"]
    H --> F
    G -- "Không" --> I{"Byte c khớp?"}
    I -- "Có" --> J["Tăng state[i]"]
    I -- "Không" --> K["Giữ state[i] = 0"]
    J --> L{"Đã khớp hết pattern?"}
    K --> M["Xét pattern tiếp theo"]
    L -- "Có" --> N["Báo offset = globalOffset - m + 1"]
    N --> O["Lùi state[i] theo pi để tìm match chồng lấn"]
    O --> M
    L -- "Không" --> M
    M --> P["Tăng globalOffset"]
    P --> D
    D -- "Không" --> Q{"Còn block kế tiếp?"}
    Q -- "Có" --> C
    Q -- "Không" --> R["Kết thúc; không reset state tại ranh giới block"]
